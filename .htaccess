<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # 启用 rewrite 引擎
    RewriteEngine On
    RewriteBase /phpemsvue

    # ==========================================
    # 1. 白名单规则（放在最前面，匹配后直接放行）
    # ==========================================
    
    # 允许访问指定的目录（例如：uploads、assets、public）
    # [L] 表示匹配成功后停止执行后续规则
    RewriteRule ^(uploads|assets|public)(/.*)?$ - [L]

    # 允许访问指定的文件（例如：robots.txt、sitemap.xml）
    RewriteRule ^(robots\.txt|sitemap\.xml)$ - [L]

    # 允许访问特定后缀的文件（例如：图片、CSS、JS）
    RewriteRule \.(jpg|jpeg|png|gif|css|js|ico)$ - [L]

    # ==========================================
    # 2. 原有核心重写规则（非白名单请求将走这里）
    # ==========================================
    
    # 排除真实存在的文件和目录（避免重写静态资源）
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 将所有请求重写到 index.php，并保留路径信息
    RewriteRule ^ index.php [L]
</IfModule>